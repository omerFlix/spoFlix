{
  "name": "spoflix",
  "version": "1.0.9",
  "description": "SpoFlix - Müzik Dinle (Masaüstü Uygulaması)",
  "main": "main.js",
  "author": "SpoFlix",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "build:tv": "esbuild app.js --target=chrome63 --outfile=app-tv.js --minify"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.11"
  },
  "build": {
    "appId": "com.spoflix.app",
    "productName": "SpoFlix",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "app.js",
      "app-tv.js",
      "style.css",
      "server.js",
      "main.js",
      "preload.js",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SpoFlix"
    }
  }
}
